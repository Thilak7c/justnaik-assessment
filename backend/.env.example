# Copy to .env and adjust. Never commit the real .env file.
PORT=4000
NODE_ENV=development

# PostgreSQL connection string
DATABASE_URL=postgres://postgres:postgres@localhost:5432/locations
# Separate database used only by the automated tests (it is wiped before every test)
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/locations_test

# Use a long random string in real deployments: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
# How long a login stays valid (e.g. 15m, 1h, 1d)
JWT_EXPIRES_IN=1h

# Frontend origin allowed by CORS
CORS_ORIGIN=http://localhost:5173

# Upload limits
MAX_UPLOAD_BYTES=5242880
MAX_UPLOAD_ROWS=10000
